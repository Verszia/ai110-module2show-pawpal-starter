classDiagram
    class Owner {
        +String name
        +time preferredStartTime
        +int availableMinutesPerDay
        +addPet(pet: Pet) void
        +removePet(pet: Pet) void
    }

    class Pet {
        +String name
        +String species
        +List~Task~ careTasks
        +addTask(task: Task) void
        +removeTask(task: Task) void
        +getTasks() List~Task~
    }

    class Task {
        +String title
        +int durationMinutes
        +String priority
        +bool isCompleted
        +markComplete() void
        +updatePriority(priority: String) void
    }

    class Scheduler {
        +time startTime
        +int availableMinutes
        +List~Task~ plan
        +buildDailyPlan(owner: Owner, pet: Pet) List~Task~
        +selectTasks(tasks: List~Task~, availableMinutes: int) List~Task~
        +explainPlan(plan: List~Task~) String
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : care tasks
    Scheduler ..> Owner : reads availability
    Scheduler ..> Pet : reads care tasks
    Scheduler ..> Task : selects and orders
