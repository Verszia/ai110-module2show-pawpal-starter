classDiagram
    class Owner {
        +String name
        +time preferredStartTime
        +int availableMinutesPerDay
        +addPet(pet: Pet) void
        +removePet(pet: Pet) void
        +getAllTasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +List~Task~ careTasks
        +addTask(task: Task) void
        +removeTask(task: Task) void
        +getTasks() List~Task~
    }

    class Task {
        +String title
        +int durationMinutes
        +String priority {high|medium|low}
        +bool isCompleted
        +time? dueBy
        +markComplete() void
        +updatePriority(priority: String) void
    }

    class ScheduledTask {
        +Task task
        +datetime startsAt
        +datetime endsAt
    }

    class Scheduler {
        +List~ScheduledTask~ plan
        +buildDailyPlan(owner: Owner, scheduleDate: date) List~ScheduledTask~
        -selectTasks(tasks: List~Task~, owner: Owner, scheduleDate: date) List~ScheduledTask~
        -canSchedule(task: Task, owner: Owner, startsAt: datetime, elapsedMinutes: int) bool
        +explainPlan(plan: List~ScheduledTask~) String
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : care tasks
    ScheduledTask --> Task : scheduled instance of
    Scheduler ..> Owner : uses preferred start and sole daily budget
    Scheduler ..> Pet : reads care tasks
    Scheduler ..> Task : ranks priority; enforces duration and deadline
    Scheduler ..> ScheduledTask : assigns start and end times
